# --- Auth (NextAuth v5) ---------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# --- Data -----------------------------------------------------------------
# Where the Python worker writes videos/, thumbs/ and alphascroll.db
WORKER_OUTPUT_DIR=../worker/output
# Likes, comments and trades
APP_DB_PATH=./data/app.db

# --- Monad ----------------------------------------------------------------
# 10143 = Monad testnet (default), 143 = Monad mainnet
NEXT_PUBLIC_CHAIN_ID=10143
# Optional custom RPC (defaults to the chain's public RPC)
NEXT_PUBLIC_RPC_URL=

# AlphaScrollSessionVault address from `npm run deploy` in contracts/.
# Leave empty to run double-tap buys in demo mode.
NEXT_PUBLIC_VAULT_ADDRESS=
# MON sent to each new session key for gas (Monad bills the full gas limit: ~0.015 MON per buy at 100 gwei)
NEXT_PUBLIC_SESSION_GAS_STIPEND=0.1
# Max slippage on double-tap buys, in basis points (800 = 8%)
NEXT_PUBLIC_SLIPPAGE_BPS=800
