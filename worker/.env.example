# Free key: https://console.groq.com/keys  (without it the worker uses a template script)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Free key: https://openrouter.ai/keys  — only free models are used (no credits needed):
#  - script fallback when Groq fails (openrouter/free picks any free model that is up)
#  - Fish Audio S2 voice-over (word timings come from Groq Whisper, so it also needs GROQ_API_KEY)
# Free accounts get ~50 free-model requests/day; past that the worker falls back to Edge-TTS.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
TTS_ENGINE=fish
FISH_MODEL=fish-audio/s2.1-pro-free:free
FISH_VOICE=

# Edge-TTS voice (used when TTS_ENGINE=edge or Fish is unavailable). List all: `edge-tts --list-voices`  (Turkish: tr-TR-AhmetNeural)
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+12%

# Bold .ttf/.otf for captions. Leave empty to auto-detect a system font.
FONT_PATH=

OUTPUT_DIR=output
DB_PATH=output/alphascroll.db
INTERVAL_MINUTES=15

# Share of videos rendered with a talking mascot avatar when --format random (0-1)
AVATAR_RATIO=0.5

# Monad testnet tokens from `npm run setup:testnet` (contracts/). Used by --source auto/testnet.
DEPLOYMENT_FILE=../contracts/deployments/10143.json
