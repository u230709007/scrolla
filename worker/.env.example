# Free key: https://console.groq.com/keys  (without it the worker uses a template script)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional local script provider, tried before cloud providers.
# Set the exact name of a model already installed in Ollama.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434

# Free key: https://openrouter.ai/keys  — only free models are used (no credits needed):
#  - script fallback when Groq fails (openrouter/free picks any free model that is up)
#  - Fish Audio S2 voice-over (word timings come from Groq Whisper, so it also needs GROQ_API_KEY)
# Free accounts get ~50 free-model requests/day; past that the worker falls back to Edge-TTS.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
TTS_ENGINE=fish
FISH_MODEL=fish-audio/s2.1-pro-free:free
FISH_VOICE=

# Edge-TTS voice (used when TTS_ENGINE=edge or Fish is unavailable). List all: `edge-tts --list-voices`  (Turkish: tr-TR-AhmetNeural)
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+12%

# Bold .ttf/.otf for captions. Leave empty to auto-detect a system font.
FONT_PATH=

OUTPUT_DIR=output
DB_PATH=output/alphascroll.db
# 0 = start the next video as soon as one finishes (~1 min each)
INTERVAL_MINUTES=0

# Share of videos rendered with a talking mascot avatar when --format random (0-1)
AVATAR_RATIO=0.5

# Monad testnet tokens from `npm run setup:testnet` (contracts/). Used by --source auto/testnet.
DEPLOYMENT_FILE=../contracts/deployments/10143.json

# --source dexscreener: live memecoins from DexScreener's free public API (no key)
DEX_CHAIN=monad
# DexScreener can't list a whole chain, so candidates come from these searches (+ boosted tokens)
DEX_QUERIES=nad,nad-fun,WMON monad,monad nad,chog
# live (trades in the last 5 min + AlphaScroll buys) | trending (volume + trades + momentum) | volume | gainers
# | losers (biggest 24h drops) | whales (biggest single buy in TRADES_WINDOW_MIN, >= WHALE_MIN_USD) | new
# | mix (a random mode per run)
DEX_PICK=live
WHALE_MIN_USD=500
DEX_MIN_LIQUIDITY=5000
DEX_MIN_VOLUME=500
# Only pairs younger than this many hours (0 = any age)
DEX_MAX_AGE_HOURS=0
# Skip tokens that already got a video in the last N hours
DEX_COOLDOWN_HOURS=6
# Pick randomly (weighted by rank) among the top N
DEX_TOP_N=5
DEX_EXCLUDE=MON,WMON,SHMON,GMON,APRMON,SMON,USDC,USDT,USDT0,AUSD,USDE,DAI,WETH,ETH,WSTETH,WBTC,CBBTC,LBTC,BTC,SOL,WSOL

# Farcaster buzz for --source dexscreener: free key at https://dev.neynar.com (empty = skipped)
# Counts casts that cashtag $SYMBOL; re-ranks the trending shortlist and feeds the script.
NEYNAR_API_KEY=
FARCASTER_HOURS=24
FARCASTER_WEIGHT=1

# Live feed: tokens bought in AlphaScroll within LIVE_MINUTES get the next videos.
# Read from the web app's database; pair with a short INTERVAL_MINUTES (e.g. 5).
APP_DB_PATH=../web/data/app.db
LIVE_MINUTES=60

# Individual on-chain trades from GeckoTerminal (free, no key) for the live picker and
# the script: buys/sells, biggest buy and repeat buyers in the last N minutes.
TRADES_WINDOW_MIN=15

# Local GPU generation (optional, needs requirements-gpu.txt + an NVIDIA GPU)
# auto: Pollinations first (~5s), SDXL-Lightning on the GPU if it's busy/down (~30s)
IMAGE_ENGINE=auto
# Threads building video frames in parallel (0 = up to 8, by CPU count)
RENDER_THREADS=0
# Share of videos with an LTX-Video animated background (0-1). Slow; or pass --motion per run.
MOTION_RATIO=0

# Cloud publishing for the deployed site (cloud.py). Same values as the web app's env.
# Empty = videos stay in output/ and the local SQLite only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob (uploads via web/scripts/blob-upload.mjs, needs `npm install` in web/)
BLOB_READ_WRITE_TOKEN=
# ...or Cloudflare R2 instead of Blob
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
